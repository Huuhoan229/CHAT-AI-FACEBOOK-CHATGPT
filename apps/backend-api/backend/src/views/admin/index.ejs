<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Admin</title>
</head>
<body>
  <h2>📊 Thống kê</h2>
  <ul>
    <li>Tổng: <%= stats.total %></li>
    <li>NEW: <%= stats.new %></li>
    <li>INTEREST: <%= stats.interest %></li>
    <li>HOT: <%= stats.hot %></li>
    <li>DONE: <%= stats.done %></li>
  </ul>

  <h2>📋 Lead</h2>
  <table border="1" cellpadding="8">
    <tr>
      <th>SĐT</th>
      <th>Trạng thái</th>
      <th>Tin nhắn cuối</th>
      <th></th>
    </tr>

    <% conversations.forEach(c => { %>
      <tr>
        <td><%= c.phone || '—' %></td>
        <td><%= c.status %></td>
        <td><%= c.messages[0]?.content || '' %></td>
        <td>
          <a href="/admin/<%= c.id %>">Xem</a>
        </td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
