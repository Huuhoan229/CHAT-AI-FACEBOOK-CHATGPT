generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// =========================
///    PRODUCT
/// =========================
model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  description String
  coverImage  String
  freeShip    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// =========================
///    CONVERSATION (LEAD)
/// =========================
model Conversation {
  id          String     @id @default(cuid())
  psid        String     @unique
  phone       String?
  status      LeadStatus @default(NEW)
  lastMessage String?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
  saleId      String?
  note        String?
  mailSent    Boolean    @default(false)
  botPaused   Boolean    @default(false)
  sale        Sale?      @relation(fields: [saleId], references: [id])
  messages    Message[]

  @@index([status])
  @@index([updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  content        String
  intent         MessageIntent @default(UNKNOWN)
  createdAt      DateTime      @default(now())
  externalId     String?       @unique
  logReason      String?
  conversation   Conversation  @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

/// =========================
///    SALE (NHÂN VIÊN)
/// =========================
model Sale {
  id        String         @id @default(cuid())
  name      String
  phone     String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  leads     Conversation[]
}

/// =========================
///    ENUMS
/// =========================
enum LeadStatus {
  NEW
  INTEREST
  HOT
  DONE_SALE
  DONE_BLOCK
}

enum MessageSender {
  USER
  BOT
  SALE
}

enum MessageIntent {
  ASK_PRICE
  ASK_SHIP
  ASK_PRODUCT
  LEAVE_PHONE
  CHITCHAT
  UNKNOWN
}

/// ===============================
/// AI CONFIG – Provider / Model
/// ===============================
model AiConfig {
  id           String   @id @default(uuid())
  provider     String   // gemini | openai | claude
  apiKey       String
  model        String
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(1024)
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// ===============================
/// AI RULE – Điều khiển hành vi bot
/// ===============================
model AiRule {
  id                 String   @id @default(uuid())

  systemPrompt       String   // prompt gốc cho AI
  tone               String   // sales | support | polite

  askPhone           Boolean  @default(true)
  allowUpsell        Boolean  @default(true)
  allowAfterDoneSale Boolean  @default(false)

  pauseKeyword       String   @default(".")
  resumeKeyword      String   @default(",")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// ===============================
/// AI TRAINING – Knowledge / Q&A
/// ===============================
model AiTraining {
  id          String   @id @default(uuid())

  title       String
  content     String
  priority    Int      @default(1)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
}

